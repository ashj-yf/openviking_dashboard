# OpenViking Dashboard 部署配置模板
# 用法：cp .env.example .env，替换全部占位值后再 `docker compose up -d --build`。
# .env 含真实密钥，切勿提交、切勿放入镜像。

# ---- 应用 ----
APP_NAME=OpenViking Dashboard
# 部署必须保持 false；DEBUG=true 会放宽 root key 与示例密钥的启动校验
DEBUG=false
# 容器内 SQLite 固定落 /app/data（compose 挂卷 ./data -> /app/data），一般无需修改
DATABASE_URL=sqlite+aiosqlite:////app/data/dashboard.db

# ---- JWT ----
# 必填：留空或示例值会拒绝启动。生成：openssl rand -base64 48
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- 留存用户 OV key 的加密主密钥（与 JWT_SECRET 独立设置）----
# 必填：留空或示例值会拒绝启动。生成：openssl rand -base64 48
SECRET_KEY=

# ---- 超管账号（可选，必须成对配置）----
# 配置后每次启动强制同步入库并刷新密码（.env 是权威来源）；
# 该账号在 UI 中不可修改；密码轮换 = 改这里后重启服务。
# 未配置时按数据库认证，但库中无可用 admin 会拒绝启动。
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=

# ---- OpenViking 服务端 ----
OPENVIKING_BASE_URL=https://ov.example.com
# 管理面 ROOT api_key：DEBUG=false 时必填；仅服务端使用，不发给浏览器
OPENVIKING_ROOT_KEY=
HTTP_TIMEOUT_SECONDS=20

# ---- CORS ----
# compose 同源部署（页面与 API 均由 8000 提供）无需跨域；
# 如经其他域名/端口访问，填实际来源，逗号分隔。
CORS_ORIGINS=http://localhost:8000
